# Copy to .env and adjust. .env is gitignored; this file is committed.
#   cp .env.example .env

# Credentials the Postgres container is created with.
POSTGRES_USER=todo
POSTGRES_PASSWORD=localdevpassword
POSTGRES_DB=todo

# Host port mapped to Postgres. Change it if 5432 is already taken.
POSTGRES_PORT=5432

# Connection string the app uses.
#
# This value is for running the app on your machine (uvicorn) against the Postgres
# container, so it points at localhost. Inside `docker compose up` the app service
# overrides it with host `db`, since that is the container's name on the compose
# network. Keep the user/password/db in sync with the values above.
DATABASE_URL=postgresql://todo:localdevpassword@localhost:5432/todo

# Leave DATABASE_URL unset (or set it to anything not starting with postgres) to fall
# back to the local SQLite file from A2 — handy for running without Docker.

# Supabase project settings, from Project Settings -> API in your Supabase dashboard.
# Used for auth (signup/login/logout/token verification), not for task storage.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_anon_key

# Port uvicorn listens on.
PORT=8000

# --- LLM (Week 7 / A17: POST /enrich) ---
# Swapping providers is these three values and nothing else.
#
# Hosted lane (used here): Gemini's OpenAI-compatible endpoint. Get a free key
# at aistudio.google.com/apikey.
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_API_KEY=your_gemini_api_key
#   LLM_MODEL=gemini-2.5-flash
#
# Alternative hosted lane: OpenRouter free tier (20 req/min, 50/day; sign up,
# flip the two privacy switches at openrouter.ai/settings/privacy, copy a key).
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=sk-or-...
#   LLM_MODEL=openrouter/free
#
# Alternative local lane: Ollama running on your machine, no account or key.
#   LLM_BASE_URL=http://localhost:11434/v1/
#   LLM_API_KEY=ollama
#   LLM_MODEL=gemma3:1b
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your_gemini_api_key
LLM_MODEL=gemini-2.5-flash

# 1 = skip the model entirely, return a hard-coded schema-valid response.
# Lets you build and debug the endpoint without spending a single call.
LLM_STUB=0

# false = skip the model, return a deterministic fallback (the kill switch).
LLM_ENABLED=true
